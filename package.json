{
  "name": "@portside-labs/gsc-mcp",
  "version": "0.1.0",
  "description": "Local MCP server for Google Search Console: search analytics, URL inspection, sitemaps and SEO opportunity finding for Claude Desktop, Claude Code and other MCP clients.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-search-console",
    "search-console",
    "gsc",
    "seo",
    "claude",
    "claude-desktop",
    "claude-code"
  ],
  "homepage": "https://github.com/portside-labs/gsc-mcp#readme",
  "bugs": "https://github.com/portside-labs/gsc-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portside-labs/gsc-mcp.git"
  },
  "license": "MIT",
  "author": "Portside Labs",
  "mcpName": "io.github.portside-labs/gsc-mcp",
  "type": "module",
  "bin": {
    "gsc-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "pack:mcpb": "npm run build && node scripts/pack-mcpb.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "google-auth-library": "^11.3.4",
    "node-html-parser": "^9.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
